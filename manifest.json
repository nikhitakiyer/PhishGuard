{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0",
  "description": "Analyzes Gmail emails for phishing and psychological manipulation tactics.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/in_fox.png"
  }
}